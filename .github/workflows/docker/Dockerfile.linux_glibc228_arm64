# =============================================================================
# Dockerfile.linux_aarch64
# Purpose: manylinux_2_28 (glibc 2.28) build env for ARM64 (Apple Silicon, AWS Graviton)
# Base: quay.io/pypa/manylinux_2_28_aarch64
# Note: CMake 3.30.0 official binary is x86_64 only → build from source or use package.
# =============================================================================

FROM quay.io/pypa/manylinux_2_28_aarch64:2024-03-10-4935fcc

# Install system dependencies
RUN yum update -y && \
    yum install -y \
        git curl wget vim rsync which \
        gcc-c++ make ninja-build \
        libuuid-devel zlib-devel openssl-devel libffi-devel \
        clang-tools-extra && \
    yum clean all

# Install Miniforge
ENV MINIFORGE_VERSION="25.11.0-1"
ENV MINIFORGE_HOME="/opt/miniforge3"
RUN curl -sSL "https://github.com/conda-forge/miniforge/releases/download/${MINIFORGE_VERSION}/Miniforge3-${MINIFORGE_VERSION}-Linux-aarch64.sh" -o miniforge.sh && \
    bash miniforge.sh -b -p ${MINIFORGE_HOME} && \
    rm miniforge.sh

ENV PATH="${MINIFORGE_HOME}/bin:${PATH}"

# Create conda environments
RUN conda create -n py310 python=3.10 -y && \
    conda create -n py311 python=3.11 -y && \
    conda create -n py312 python=3.12 -y && \
    conda clean --all -f -y

# Install CMake 3.30.0 from source (no official ARM64 binary)
RUN git clone --branch v3.30.0 --depth 1 https://github.com/Kitware/CMake.git /tmp/cmake-src && \
    cd /tmp/cmake-src && \
    ./bootstrap --prefix=/usr/local && \
    make -j$(nproc) && \
    make install && \
    rm -rf /tmp/cmake-src

# Alias clang-format
RUN pip install clang-format==18.1.8 && \
 ln -sf /opt/miniforge3/bin/clang-format /usr/bin/clang-format-18 || true

# Verify
RUN cmake --version && \
    python3.10 --version && \
    gcc --version && \
    ldd --version | head -n1 && \
    clang-format-18 --version

WORKDIR /workspace