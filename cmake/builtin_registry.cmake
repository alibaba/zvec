# Built-in modules have ordinary externally referenced registration functions.
# Each final component consumer gets a directory for its linked modules; the
# complete static SDK carries its own directory inside zvec_core.
include_guard(GLOBAL)

function(zvec_collect_source_builtins RESULT)
  set(SYMBOLS)
  foreach(SOURCE IN LISTS ARGN)
    if(NOT IS_ABSOLUTE "${SOURCE}")
      get_filename_component(SOURCE "${SOURCE}" ABSOLUTE)
    endif()
    if(NOT SOURCE MATCHES "\\.(cc|cpp|cxx)$" OR NOT EXISTS "${SOURCE}")
      continue()
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${SOURCE}")
    file(READ "${SOURCE}" SOURCE_TEXT)
    string(REGEX MATCHALL
      "INDEX_FACTORY_DEFINE_[A-Z_]+[ \t\r\n]*\\([ \t\r\n]*[A-Za-z_][A-Za-z0-9_]*"
      DEFINITIONS "${SOURCE_TEXT}")
    foreach(DEFINITION IN LISTS DEFINITIONS)
      string(REGEX REPLACE
        "INDEX_FACTORY_DEFINE_([A-Z_]+)[ \t\r\n]*\\([ \t\r\n]*([A-Za-z_][A-Za-z0-9_]*)"
        "\\1;\\2" PARTS "${DEFINITION}")
      list(GET PARTS 0 CATEGORY)
      list(GET PARTS 1 NAME)
      string(REGEX REPLACE "_ALIAS$" "" CATEGORY "${CATEGORY}")
      list(APPEND SYMBOLS "RegisterBuiltin${CATEGORY}_${NAME}")
    endforeach()
  endforeach()
  list(REMOVE_DUPLICATES SYMBOLS)
  list(SORT SYMBOLS)
  set(${RESULT} "${SYMBOLS}" PARENT_SCOPE)
endfunction()

function(zvec_write_builtin_registry OUTPUT_FILE)
  set(ROOT_NAME RegisterBuiltinIndexModules)
  if(OUTPUT_FILE MATCHES "quantizer_registry")
    set(ROOT_NAME RegisterBuiltinQuantizers)
  endif()
  set(SYMBOLS ${ARGN})
  list(REMOVE_DUPLICATES SYMBOLS)
  list(SORT SYMBOLS)
  set(CONTENT "// Generated from the built-in definitions in the linked sources.\n#include <zvec/core/framework/index_factory_builtins.h>\nnamespace zvec { namespace core {\n")
  foreach(SYMBOL IN LISTS SYMBOLS)
    string(APPEND CONTENT "void ${SYMBOL}();\n")
  endforeach()
  string(APPEND CONTENT "\nvoid ${ROOT_NAME}() {\n  static const bool initialized = [] {\n")
  foreach(SYMBOL IN LISTS SYMBOLS)
    string(APPEND CONTENT "    ${SYMBOL}();\n")
  endforeach()
  string(APPEND CONTENT "    return true;\n  }();\n  (void)initialized;\n}\nnamespace { const bool registered = [] { ${ROOT_NAME}(); return true; }(); }\n} }  // namespace zvec::core\n")
  file(CONFIGURE OUTPUT "${OUTPUT_FILE}" CONTENT "${CONTENT}" @ONLY)
endfunction()

# Internal component consumers use archives in one module. This also keeps
# factory state local to the application on platforms without ELF interposition.
# Public all-in-one shared SDKs use their component-owned object libraries.
function(zvec_resolve_component_libraries RESULT)
  set(LIBRARIES)
  foreach(LIBRARY IN LISTS ARGN)
    set(LINK_ONLY FALSE)
    if(LIBRARY MATCHES "^\\$<LINK_ONLY:([^>]+)>$")
      set(LIBRARY "${CMAKE_MATCH_1}")
      set(LINK_ONLY TRUE)
    endif()
    if(TARGET "${LIBRARY}" AND TARGET "${LIBRARY}_static")
      get_target_property(LIBRARY_TYPE "${LIBRARY}" TYPE)
      if(LIBRARY_TYPE STREQUAL "SHARED_LIBRARY")
        set(LIBRARY "${LIBRARY}_static")
      endif()
    endif()
    if(LINK_ONLY)
      list(APPEND LIBRARIES "$<LINK_ONLY:${LIBRARY}>")
    else()
      list(APPEND LIBRARIES "${LIBRARY}")
    endif()
  endforeach()
  set(${RESULT} "${LIBRARIES}" PARENT_SCOPE)
endfunction()

# Targets may name components whose subdirectories have not been visited yet.
# Resolve the complete dependency graph before generating any component root.
# Deferring also includes libraries appended after cc_library/cc_binary returns.
function(zvec_defer_component_finalization TARGET_NAME)
  set_property(GLOBAL APPEND PROPERTY ZVEC_COMPONENT_TARGETS "${TARGET_NAME}")
  get_property(SCHEDULED GLOBAL PROPERTY ZVEC_COMPONENT_FINALIZATION_SCHEDULED)
  if(NOT SCHEDULED)
    set_property(GLOBAL PROPERTY ZVEC_COMPONENT_FINALIZATION_SCHEDULED TRUE)
    cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}"
      CALL zvec_finalize_component_libraries)
  endif()
endfunction()

# Discover native CMake consumers as well as cc_* targets, including targets
# defined by a parent project after add_subdirectory(zvec) returns.
function(zvec_directory_targets RESULT DIRECTORY)
  get_property(TARGETS DIRECTORY "${DIRECTORY}" PROPERTY BUILDSYSTEM_TARGETS)
  get_property(CHILDREN DIRECTORY "${DIRECTORY}" PROPERTY SUBDIRECTORIES)
  foreach(CHILD IN LISTS CHILDREN)
    zvec_directory_targets(CHILD_TARGETS "${CHILD}")
    list(APPEND TARGETS ${CHILD_TARGETS})
  endforeach()
  set(${RESULT} "${TARGETS}" PARENT_SCOPE)
endfunction()

# A real reference to one symbol per registration TU replaces archive forcing.
# The forced include adds a definition, not a linker retention option. It also
# supports legacy static initializers which do not include factory.h.
function(zvec_collect_legacy_anchors TARGET_NAME)
  get_target_property(SOURCES ${TARGET_NAME} SOURCES)
  get_target_property(SOURCE_DIR ${TARGET_NAME} SOURCE_DIR)
  get_target_property(KEEP_ALL ${TARGET_NAME} ALWAYS_LINK)
  set(ANCHORS)
  set(REGISTRATION_SOURCES)
  foreach(SOURCE IN LISTS SOURCES)
    if(NOT IS_ABSOLUTE "${SOURCE}")
      set(SOURCE "${SOURCE_DIR}/${SOURCE}")
    endif()
    if(NOT SOURCE MATCHES "\\.(c|cc|cpp|cxx)$" OR NOT EXISTS "${SOURCE}")
      continue()
    endif()
    list(APPEND REGISTRATION_SOURCES "${SOURCE}")
    file(READ "${SOURCE}" TEXT)
    if(NOT KEEP_ALL AND NOT TEXT MATCHES "(INDEX_FACTORY_REGISTER_[A-Z_]+|AILEGO_FACTORY_REGISTER|FACTORY_REGISTER_LOGGER(_ALIAS)?)[ \t\r\n]*\\(")
      continue()
    endif()
    string(SHA256 HASH "${SOURCE}")
    set(ANCHOR "zvec_registration_${HASH}")
    set(HEADER "${CMAKE_BINARY_DIR}/zvec_registration_anchors/${HASH}.h")
    file(CONFIGURE OUTPUT "${HEADER}" CONTENT
      "#pragma once\n#ifdef __cplusplus\nextern \"C\" {\n#endif\nvoid ${ANCHOR}(void) {}\n#ifdef __cplusplus\n}\n#endif\n" @ONLY)
    get_property(INJECTED SOURCE "${SOURCE}" TARGET_DIRECTORY ${TARGET_NAME}
      PROPERTY ZVEC_REGISTRATION_ANCHOR)
    if(NOT INJECTED)
      if(MSVC)
        set(OPTIONS "/FI${HEADER}")
      else()
        set(OPTIONS "-include;${HEADER}")
      endif()
      set_property(SOURCE "${SOURCE}" TARGET_DIRECTORY ${TARGET_NAME}
        APPEND PROPERTY COMPILE_OPTIONS ${OPTIONS})
      set_property(SOURCE "${SOURCE}" TARGET_DIRECTORY ${TARGET_NAME}
        PROPERTY ZVEC_REGISTRATION_ANCHOR "${ANCHOR}")
    endif()
    list(APPEND ANCHORS "${ANCHOR}")
  endforeach()
  zvec_collect_source_builtins(SYMBOLS ${REGISTRATION_SOURCES})
  set_property(TARGET ${TARGET_NAME} PROPERTY ZVEC_BUILTIN_SYMBOLS "${SYMBOLS}")
  set_property(TARGET ${TARGET_NAME} PROPERTY ZVEC_REGISTRATION_ANCHORS "${ANCHORS}")
endfunction()

# Prebuilt archives must expose an actual initialization entry point. No linker
# can discover a registration-only object with no referenced external symbol.
function(zvec_link_static_extension)
  cmake_parse_arguments(EXT "" "TARGET;LIBRARY;INITIALIZER" "" ${ARGN})
  if(NOT TARGET "${EXT_TARGET}" OR NOT EXT_LIBRARY OR
     NOT EXT_INITIALIZER MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
    message(FATAL_ERROR "Expected TARGET, LIBRARY and an extern C INITIALIZER")
  endif()
  target_link_libraries(${EXT_TARGET} PRIVATE ${EXT_LIBRARY})
  set_property(TARGET ${EXT_TARGET} APPEND PROPERTY
    ZVEC_EXTENSION_INITIALIZERS "${EXT_INITIALIZER}")
  zvec_defer_component_finalization(${EXT_TARGET})
endfunction()

function(zvec_finalize_component_libraries)
  zvec_directory_targets(TARGETS "${CMAKE_SOURCE_DIR}")
  foreach(TARGET_NAME IN LISTS TARGETS)
    get_target_property(TYPE ${TARGET_NAME} TYPE)
    if(TYPE STREQUAL "UTILITY")
      continue()
    endif()
    foreach(PROPERTY LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
      get_target_property(DEPENDENCIES "${TARGET_NAME}" "${PROPERTY}")
      if(DEPENDENCIES)
        zvec_resolve_component_libraries(DEPENDENCIES ${DEPENDENCIES})
        set_property(TARGET "${TARGET_NAME}" PROPERTY "${PROPERTY}" "${DEPENDENCIES}")
      endif()
    endforeach()
    zvec_collect_legacy_anchors(${TARGET_NAME})
  endforeach()
  foreach(TARGET_NAME IN LISTS TARGETS)
    zvec_attach_builtin_registry("${TARGET_NAME}")
  endforeach()
endfunction()

function(zvec_attach_builtin_registry TARGET_NAME)
  get_target_property(TARGET_TYPE ${TARGET_NAME} TYPE)
  if(NOT TARGET_TYPE MATCHES "^(EXECUTABLE|SHARED_LIBRARY|MODULE_LIBRARY)$")
    return()
  endif()
  get_target_property(ALREADY_ATTACHED ${TARGET_NAME} ZVEC_REGISTRY_ATTACHED)
  if(ALREADY_ATTACHED)
    return()
  endif()
  set(PENDING ${TARGET_NAME})
  set(VISITED)
  set(SYMBOLS)
  set(USES_FACTORY FALSE)
  set(HAS_SDK_REGISTRY FALSE)
  set(ANCHORS)
  while(PENDING)
    list(POP_FRONT PENDING LIBRARY)
    # CMake wraps private static-library dependencies in LINK_ONLY.
    string(REGEX REPLACE "^\\$<LINK_ONLY:([^>]+)>$" "\\1" LIBRARY "${LIBRARY}")
    if(NOT TARGET "${LIBRARY}" OR LIBRARY IN_LIST VISITED)
      continue()
    endif()
    list(APPEND VISITED "${LIBRARY}")
    get_target_property(HAS_REGISTRY ${LIBRARY} ZVEC_HAS_BUILTIN_REGISTRY)
    if(HAS_REGISTRY)
      # The full SDK provides the strong root itself, including for consumers
      # outside this build tree that link its archives directly.
      set(HAS_SDK_REGISTRY TRUE)
    endif()
    get_target_property(HAS_FACTORY ${LIBRARY} ZVEC_USES_INDEX_FACTORY)
    if(HAS_FACTORY)
      set(USES_FACTORY TRUE)
    endif()
    get_target_property(LIBRARY_SYMBOLS ${LIBRARY} ZVEC_BUILTIN_SYMBOLS)
    if(LIBRARY_SYMBOLS)
      list(APPEND SYMBOLS ${LIBRARY_SYMBOLS})
    endif()
    foreach(PROPERTY ZVEC_REGISTRATION_ANCHORS ZVEC_EXTENSION_INITIALIZERS)
      get_target_property(ENTRIES ${LIBRARY} ${PROPERTY})
      if(ENTRIES)
        list(APPEND ANCHORS ${ENTRIES})
      endif()
    endforeach()
    get_target_property(SOURCES ${LIBRARY} SOURCES)
    foreach(SOURCE IN LISTS SOURCES)
      if(SOURCE MATCHES "^\\$<TARGET_OBJECTS:([^>]+)>$")
        list(APPEND PENDING "${CMAKE_MATCH_1}")
      endif()
    endforeach()
    foreach(PROPERTY LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
      get_target_property(DEPENDENCIES ${LIBRARY} ${PROPERTY})
      if(DEPENDENCIES)
        list(APPEND PENDING ${DEPENDENCIES})
      endif()
    endforeach()
  endwhile()
  if(USES_FACTORY AND NOT HAS_SDK_REGISTRY)
    get_target_property(TARGET_BINARY_DIR ${TARGET_NAME} BINARY_DIR)
    set(REGISTRY_SOURCE "${TARGET_BINARY_DIR}/${TARGET_NAME}_builtin_registry.cc")
    list(FILTER SYMBOLS EXCLUDE REGEX "^RegisterBuiltinQUANTIZER_")
    zvec_write_builtin_registry("${REGISTRY_SOURCE}" ${SYMBOLS})
    target_sources(${TARGET_NAME} PRIVATE "${REGISTRY_SOURCE}")
    set_property(TARGET ${TARGET_NAME} PROPERTY ZVEC_REGISTRY_ATTACHED TRUE)
  endif()
  if(ANCHORS)
    list(REMOVE_DUPLICATES ANCHORS)
    get_target_property(TARGET_BINARY_DIR ${TARGET_NAME} BINARY_DIR)
    set(EXT_SOURCE "${TARGET_BINARY_DIR}/${TARGET_NAME}_extensions.cc")
    set(CONTENT "// Explicit references to extension registration entry points.\n")
    foreach(ANCHOR IN LISTS ANCHORS)
      string(APPEND CONTENT "extern \"C\" void ${ANCHOR}();\n")
    endforeach()
    string(APPEND CONTENT "namespace { const bool extensions = [] {\n")
    foreach(ANCHOR IN LISTS ANCHORS)
      string(APPEND CONTENT "  ${ANCHOR}();\n")
    endforeach()
    string(APPEND CONTENT "  return true;\n}(); }\n")
    file(CONFIGURE OUTPUT "${EXT_SOURCE}" CONTENT "${CONTENT}" @ONLY)
    target_sources(${TARGET_NAME} PRIVATE "${EXT_SOURCE}")
  endif()
endfunction()
