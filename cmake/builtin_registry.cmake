# Built-in modules have ordinary externally referenced registration functions.
# Each final component consumer gets a directory for its linked modules; the
# complete static SDK carries its own directory inside zvec_core.
include_guard(GLOBAL)

function(zvec_collect_source_builtins RESULT)
  set(SYMBOLS)
  foreach(SOURCE IN LISTS ARGN)
    if(NOT IS_ABSOLUTE "${SOURCE}")
      get_filename_component(SOURCE "${SOURCE}" ABSOLUTE)
    endif()
    if(NOT SOURCE MATCHES "\\.(cc|cpp|cxx)$" OR NOT EXISTS "${SOURCE}")
      continue()
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${SOURCE}")
    file(READ "${SOURCE}" SOURCE_TEXT)
    string(REGEX MATCHALL
      "INDEX_FACTORY_DEFINE_[A-Z_]+[ \t\r\n]*\\([ \t\r\n]*[A-Za-z_][A-Za-z0-9_]*"
      DEFINITIONS "${SOURCE_TEXT}")
    foreach(DEFINITION IN LISTS DEFINITIONS)
      string(REGEX REPLACE
        "INDEX_FACTORY_DEFINE_([A-Z_]+)[ \t\r\n]*\\([ \t\r\n]*([A-Za-z_][A-Za-z0-9_]*)"
        "\\1;\\2" PARTS "${DEFINITION}")
      list(GET PARTS 0 CATEGORY)
      list(GET PARTS 1 NAME)
      string(REGEX REPLACE "_ALIAS$" "" CATEGORY "${CATEGORY}")
      list(APPEND SYMBOLS "RegisterBuiltin${CATEGORY}_${NAME}")
    endforeach()
  endforeach()
  list(REMOVE_DUPLICATES SYMBOLS)
  list(SORT SYMBOLS)
  set(${RESULT} "${SYMBOLS}" PARENT_SCOPE)
endfunction()

function(zvec_write_builtin_registry OUTPUT_FILE)
  set(SYMBOLS ${ARGN})
  list(REMOVE_DUPLICATES SYMBOLS)
  list(SORT SYMBOLS)
  set(CONTENT "// Generated from the built-in definitions in the linked sources.\nnamespace zvec { namespace core {\n")
  foreach(SYMBOL IN LISTS SYMBOLS)
    string(APPEND CONTENT "void ${SYMBOL}();\n")
  endforeach()
  string(APPEND CONTENT "\nvoid RegisterBuiltinIndexModules() {\n  static const bool initialized = [] {\n")
  foreach(SYMBOL IN LISTS SYMBOLS)
    string(APPEND CONTENT "    ${SYMBOL}();\n")
  endforeach()
  string(APPEND CONTENT "    return true;\n  }();\n  (void)initialized;\n}\n} }  // namespace zvec::core\n")
  file(CONFIGURE OUTPUT "${OUTPUT_FILE}" CONTENT "${CONTENT}" @ONLY)
endfunction()

# Internal component consumers use archives in one module. This also keeps
# factory state local to the application on platforms without ELF interposition.
# Public all-in-one shared SDKs use their component-owned object libraries.
function(zvec_resolve_component_libraries RESULT)
  set(LIBRARIES)
  foreach(LIBRARY IN LISTS ARGN)
    set(LINK_ONLY FALSE)
    if(LIBRARY MATCHES "^\\$<LINK_ONLY:([^>]+)>$")
      set(LIBRARY "${CMAKE_MATCH_1}")
      set(LINK_ONLY TRUE)
    endif()
    if(TARGET "${LIBRARY}" AND TARGET "${LIBRARY}_static")
      get_target_property(LIBRARY_TYPE "${LIBRARY}" TYPE)
      if(LIBRARY_TYPE STREQUAL "SHARED_LIBRARY")
        set(LIBRARY "${LIBRARY}_static")
      endif()
    endif()
    if(LINK_ONLY)
      list(APPEND LIBRARIES "$<LINK_ONLY:${LIBRARY}>")
    else()
      list(APPEND LIBRARIES "${LIBRARY}")
    endif()
  endforeach()
  set(${RESULT} "${LIBRARIES}" PARENT_SCOPE)
endfunction()

# Targets may name components whose subdirectories have not been visited yet.
# Resolve the complete dependency graph before generating any component root.
# Deferring also includes libraries appended after cc_library/cc_binary returns.
function(zvec_defer_component_finalization TARGET_NAME)
  set_property(GLOBAL APPEND PROPERTY ZVEC_COMPONENT_TARGETS "${TARGET_NAME}")
  get_property(SCHEDULED GLOBAL PROPERTY ZVEC_COMPONENT_FINALIZATION_SCHEDULED)
  if(NOT SCHEDULED)
    set_property(GLOBAL PROPERTY ZVEC_COMPONENT_FINALIZATION_SCHEDULED TRUE)
    cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}"
      CALL zvec_finalize_component_libraries)
  endif()
endfunction()

function(zvec_finalize_component_libraries)
  get_property(TARGETS GLOBAL PROPERTY ZVEC_COMPONENT_TARGETS)
  list(REMOVE_DUPLICATES TARGETS)
  foreach(TARGET_NAME IN LISTS TARGETS)
    foreach(PROPERTY LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
      get_target_property(DEPENDENCIES "${TARGET_NAME}" "${PROPERTY}")
      if(DEPENDENCIES)
        zvec_resolve_component_libraries(DEPENDENCIES ${DEPENDENCIES})
        set_property(TARGET "${TARGET_NAME}" PROPERTY "${PROPERTY}" "${DEPENDENCIES}")
      endif()
    endforeach()
  endforeach()
  foreach(TARGET_NAME IN LISTS TARGETS)
    zvec_attach_builtin_registry("${TARGET_NAME}")
  endforeach()
endfunction()

function(zvec_attach_builtin_registry TARGET_NAME)
  get_target_property(TARGET_TYPE ${TARGET_NAME} TYPE)
  if(NOT TARGET_TYPE MATCHES "^(EXECUTABLE|SHARED_LIBRARY|MODULE_LIBRARY)$")
    return()
  endif()
  get_target_property(ALREADY_ATTACHED ${TARGET_NAME} ZVEC_REGISTRY_ATTACHED)
  if(ALREADY_ATTACHED)
    return()
  endif()
  set(PENDING ${TARGET_NAME})
  set(VISITED)
  set(SYMBOLS)
  set(USES_FACTORY FALSE)
  while(PENDING)
    list(POP_FRONT PENDING LIBRARY)
    # CMake wraps private static-library dependencies in LINK_ONLY.
    string(REGEX REPLACE "^\\$<LINK_ONLY:([^>]+)>$" "\\1" LIBRARY "${LIBRARY}")
    if(NOT TARGET "${LIBRARY}" OR LIBRARY IN_LIST VISITED)
      continue()
    endif()
    list(APPEND VISITED "${LIBRARY}")
    get_target_property(HAS_REGISTRY ${LIBRARY} ZVEC_HAS_BUILTIN_REGISTRY)
    if(HAS_REGISTRY)
      # The full SDK provides the strong root itself, including for consumers
      # outside this build tree that link its archives directly.
      return()
    endif()
    get_target_property(HAS_FACTORY ${LIBRARY} ZVEC_USES_INDEX_FACTORY)
    if(HAS_FACTORY)
      set(USES_FACTORY TRUE)
    endif()
    get_target_property(LIBRARY_SYMBOLS ${LIBRARY} ZVEC_BUILTIN_SYMBOLS)
    if(LIBRARY_SYMBOLS)
      list(APPEND SYMBOLS ${LIBRARY_SYMBOLS})
    endif()
    foreach(PROPERTY LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
      get_target_property(DEPENDENCIES ${LIBRARY} ${PROPERTY})
      if(DEPENDENCIES)
        list(APPEND PENDING ${DEPENDENCIES})
      endif()
    endforeach()
  endwhile()
  if(USES_FACTORY)
    get_target_property(TARGET_BINARY_DIR ${TARGET_NAME} BINARY_DIR)
    set(REGISTRY_SOURCE "${TARGET_BINARY_DIR}/${TARGET_NAME}_builtin_registry.cc")
    zvec_write_builtin_registry("${REGISTRY_SOURCE}" ${SYMBOLS})
    target_sources(${TARGET_NAME} PRIVATE "${REGISTRY_SOURCE}")
    set_property(TARGET ${TARGET_NAME} PROPERTY ZVEC_REGISTRY_ATTACHED TRUE)
  endif()
endfunction()
