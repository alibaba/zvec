+  static double ParseProbability(const string& text) {
+#ifdef _WIN32
+    using Locale = std::remove_pointer_t<_locale_t>;
+    static const std::unique_ptr<Locale, decltype(&_free_locale)> numericLocale(
+        _create_locale(LC_NUMERIC, "C"), &_free_locale);
+    if (numericLocale) {
+      return _strtod_l(text.c_str(), NULL, numericLocale.get());
+    }
+#else
+    using Locale = std::remove_pointer_t<locale_t>;
+    static const std::unique_ptr<Locale, decltype(&freelocale)> numericLocale(
+        newlocale(LC_NUMERIC_MASK, "C", NULL), &freelocale);
+    if (numericLocale) {
+      return strtod_l(text.c_str(), NULL, numericLocale.get());
+    }
+#endif
+    std::istringstream input(text);
+    input.imbue(std::locale::classic());
+    double value = 0;
+    input >> value;
+    return value;
+  }
