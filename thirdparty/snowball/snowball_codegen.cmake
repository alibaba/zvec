# CMake-native code generation for Snowball UTF-8 stemmers.
#
# This is a CMake translation of Snowball's GNUmakefile UTF-8 generation
# rules. It does not require GNU Make, Perl, or sed.
#
# Usage from thirdparty/snowball/CMakeLists.txt:
#   include("${CMAKE_CURRENT_SOURCE_DIR}/snowball_codegen.cmake")
#   snowball_generate_utf8(
#     SOURCE_DIR "${SNOWBALL_SOURCE_DIR}"
#     BUILD_DIR "${SNOWBALL_BUILD_DIR}"
#     COMPILER "$<TARGET_FILE:snowball_compiler>"
#     COMPILER_DEPENDENCY snowball_compiler
#   )
#
# Parameters:
#   SOURCE_DIR - path to the Snowball source tree (contains GNUmakefile)
#   BUILD_DIR  - path to the codegen output directory
#   COMPILER   - Snowball compiler executable or generator expression
#   COMPILER_DEPENDENCY - target or file that produces COMPILER
#
# After the call, the following variables are available in the caller scope:
#   SNOWBALL_GENERATED_SOURCES - generated/runtime/libstemmer/stemmer sources
#   SNOWBALL_GENERATED_HEADERS - generated module and stemmer headers
#   SNOWBALL_CODEGEN_TARGET    - custom target that generates all outputs

function(snowball_generate_utf8)
  cmake_parse_arguments(SNOWBALL_GEN ""
    "SOURCE_DIR;BUILD_DIR;COMPILER;COMPILER_DEPENDENCY" "" ${ARGN})

  if(NOT SNOWBALL_GEN_SOURCE_DIR OR
     NOT SNOWBALL_GEN_BUILD_DIR OR
     NOT SNOWBALL_GEN_COMPILER OR
     NOT SNOWBALL_GEN_COMPILER_DEPENDENCY)
    message(FATAL_ERROR
      "snowball_generate_utf8 requires SOURCE_DIR, BUILD_DIR, COMPILER, and "
      "COMPILER_DEPENDENCY")
  endif()

  file(MAKE_DIRECTORY
    "${SNOWBALL_GEN_BUILD_DIR}/include"
    "${SNOWBALL_GEN_BUILD_DIR}/libstemmer"
    "${SNOWBALL_GEN_BUILD_DIR}/runtime"
    "${SNOWBALL_GEN_BUILD_DIR}/src_c"
  )
  file(COPY "${SNOWBALL_GEN_SOURCE_DIR}/include/"
       DESTINATION "${SNOWBALL_GEN_BUILD_DIR}/include")
  file(COPY "${SNOWBALL_GEN_SOURCE_DIR}/runtime/"
       DESTINATION "${SNOWBALL_GEN_BUILD_DIR}/runtime")

  # -------------------------------------------------------------------------
  # Parse modules.txt → UTF-8 algorithm list and alias table
  # -------------------------------------------------------------------------
  set(_modules_txt "${SNOWBALL_GEN_SOURCE_DIR}/libstemmer/modules.txt")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_modules_txt}")

  set(_gen_srcs)
  set(_gen_hdrs)
  set(_algorithms)
  set(_aliases)
  file(STRINGS "${_modules_txt}" _lines)
  foreach(_line IN LISTS _lines)
    if(_line MATCHES "^[ \t]*#" OR _line MATCHES "^[ \t]*$")
      continue()
    endif()
    if(_line MATCHES "^([A-Za-z_]+)[ \t]+([A-Za-z_0-9,]+)[ \t]+([^ \t]+)")
      set(_alg "${CMAKE_MATCH_1}")
      string(REPLACE "," ";" _encs "${CMAKE_MATCH_2}")
      list(FIND _encs "UTF_8" _utf8_index)
      if(_utf8_index EQUAL -1)
        continue()
      endif()

      list(APPEND _algorithms "${_alg}")
      list(APPEND _gen_srcs
        "${SNOWBALL_GEN_BUILD_DIR}/src_c/stem_UTF_8_${_alg}.c")
      list(APPEND _gen_hdrs
        "${SNOWBALL_GEN_BUILD_DIR}/src_c/stem_UTF_8_${_alg}.h")

      string(REPLACE "," ";" _alias_list "${CMAKE_MATCH_3}")
      foreach(_alias IN LISTS _alias_list)
        list(APPEND _aliases "${_alias}")
        set(_alias_alg_${_alias} "${_alg}")
      endforeach()
    endif()
  endforeach()
  list(SORT _algorithms)
  list(SORT _aliases)

  if(NOT _algorithms)
    message(FATAL_ERROR
            "No UTF_8 algorithms parsed from ${_modules_txt}")
  endif()

  # -------------------------------------------------------------------------
  # Generate libstemmer/modules_utf8.h
  # -------------------------------------------------------------------------
  set(_modules_h "${SNOWBALL_GEN_BUILD_DIR}/libstemmer/modules_utf8.h")
  file(WRITE "${_modules_h}"
"/* modules_utf8.h: List of stemming modules.
 *
 * This file is generated by CMake from Snowball modules.txt.
 * Do not edit manually.
 *
 * Modules included by this file are: ")
  foreach(_alg IN LISTS _algorithms)
    file(APPEND "${_modules_h}" "${_alg}, ")
  endforeach()
  file(APPEND "${_modules_h}" "\n */\n\n")
  foreach(_alg IN LISTS _algorithms)
    file(APPEND "${_modules_h}"
      "#include \"../src_c/stem_UTF_8_${_alg}.h\"\n")
  endforeach()
  file(APPEND "${_modules_h}"
"\ntypedef enum {
  ENC_UNKNOWN=0,
  ENC_UTF_8
} stemmer_encoding_t;

struct stemmer_encoding {
  const char * name;
  stemmer_encoding_t enc;
};
static const struct stemmer_encoding encodings[] = {
  {\"UTF_8\", ENC_UTF_8},
  {0,ENC_UNKNOWN}
};

struct stemmer_modules {
  const char * name;
  stemmer_encoding_t enc;
  struct SN_env * (*create)(void);
  void (*close)(struct SN_env *);
  int (*stem)(struct SN_env *);
};
static const struct stemmer_modules modules[] = {
")
  foreach(_alias IN LISTS _aliases)
    set(_alg "${_alias_alg_${_alias}}")
    file(APPEND "${_modules_h}"
      "  {\"${_alias}\", ENC_UTF_8, ${_alg}_UTF_8_create_env, ${_alg}_UTF_8_close_env, ${_alg}_UTF_8_stem},\n")
  endforeach()
  file(APPEND "${_modules_h}"
"  {0,ENC_UNKNOWN,0,0,0}
};

static const char * algorithm_names[] = {
")
  foreach(_alg IN LISTS _algorithms)
    file(APPEND "${_modules_h}" "  \"${_alg}\", \n")
  endforeach()
  file(APPEND "${_modules_h}" "  0\n};\n")

  # -------------------------------------------------------------------------
  # Generate libstemmer/libstemmer_utf8.c from upstream template
  # -------------------------------------------------------------------------
  set(MODULES_H "modules_utf8.h")
  configure_file(
    "${SNOWBALL_GEN_SOURCE_DIR}/libstemmer/libstemmer_c.in"
    "${SNOWBALL_GEN_BUILD_DIR}/libstemmer/libstemmer_utf8.c"
    @ONLY
  )

  # -------------------------------------------------------------------------
  # Generate stemmer sources with the native Snowball compiler
  # -------------------------------------------------------------------------
  foreach(_alg IN LISTS _algorithms)
    add_custom_command(
      OUTPUT
        "${SNOWBALL_GEN_BUILD_DIR}/src_c/stem_UTF_8_${_alg}.c"
        "${SNOWBALL_GEN_BUILD_DIR}/src_c/stem_UTF_8_${_alg}.h"
      COMMAND ${CMAKE_COMMAND} -E make_directory
              "${SNOWBALL_GEN_BUILD_DIR}/src_c"
      COMMAND ${SNOWBALL_GEN_COMPILER}
              "${SNOWBALL_GEN_SOURCE_DIR}/algorithms/${_alg}.sbl"
              -o "${SNOWBALL_GEN_BUILD_DIR}/src_c/stem_UTF_8_${_alg}.c"
              -eprefix "${_alg}_UTF_8_"
              -r ../runtime
              -u
      DEPENDS ${SNOWBALL_GEN_COMPILER_DEPENDENCY}
              "${SNOWBALL_GEN_SOURCE_DIR}/algorithms/${_alg}.sbl"
      VERBATIM
    )
  endforeach()

  add_custom_target(snowball_codegen
    DEPENDS
      "${SNOWBALL_GEN_BUILD_DIR}/libstemmer/libstemmer_utf8.c"
      "${_modules_h}"
      ${_gen_srcs}
      ${_gen_hdrs}
  )

  set(SNOWBALL_GENERATED_SOURCES
    "${SNOWBALL_GEN_BUILD_DIR}/runtime/api.c"
    "${SNOWBALL_GEN_BUILD_DIR}/runtime/utilities.c"
    "${SNOWBALL_GEN_BUILD_DIR}/libstemmer/libstemmer_utf8.c"
    ${_gen_srcs}
    PARENT_SCOPE
  )
  set(SNOWBALL_GENERATED_HEADERS
    "${_modules_h}"
    ${_gen_hdrs}
    PARENT_SCOPE
  )
  set(SNOWBALL_CODEGEN_TARGET snowball_codegen PARENT_SCOPE)
endfunction()
